# Publishing the block-race feed. Installed to config\publish-race.env and run by
# the "XL1 Race Publisher" task every 15 minutes:
#
#   scripts\xl1-publish.ps1 -Config config\publish-race.env
#
# Same publisher and repository as this node's status (see publish.env.template);
# only the source, the filename and the working copy differ. The race service
# (scripts\race\race-service.mjs) builds race.json and serves it on loopback.
XL1_PUBLISH_REPO=https://github.com/LewSales/xl1-status-data.git
XL1_PUBLISH_BRANCH=main
XL1_PUBLISH_PATH=.
XL1_PUBLISH_FILE=race.json

# No page travels with the race feed: the race board lives on oxyon.io/xl1/race/.
XL1_PUBLISH_PAGE=

# A separate working copy from the status publisher, so the two tasks never
# share a checkout while both are running.
XL1_PUBLISH_WORKDIR=state\publish-race

XL1_PUBLISH_URL=http://127.0.0.1:8099/race.json
XL1_PUBLISH_TOKEN=

XL1_PUBLISH_GIT_NAME=xl1-publisher
XL1_PUBLISH_GIT_EMAIL=xl1-publisher@users.noreply.github.com
